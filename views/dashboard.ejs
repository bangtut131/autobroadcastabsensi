<!DOCTYPE html>
<html lang="id">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard - Absensi Broadcast</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <style>
        body {
            background-color: #f8f9fa;
        }

        .sidebar {
            height: 100vh;
            position: fixed;
            top: 0;
            left: 0;
            width: 250px;
            background: #2c3e50;
            color: white;
            padding-top: 20px;
        }

        .sidebar a {
            color: #adb5bd;
            text-decoration: none;
            display: block;
            padding: 10px 20px;
        }

        .sidebar a:hover,
        .sidebar a.active {
            background: #34495e;
            color: white;
            border-left: 4px solid #3498db;
        }

        .content {
            margin-left: 250px;
            padding: 20px;
        }

        .card-custom {
            border: none;
            border-radius: 10px;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        }
    </style>
</head>

<body>

    <div class="sidebar">
        <h4 class="text-center mb-4">Absensi App</h4>
        <a href="/" class="<%= page === 'dashboard' ? 'active' : '' %>"><i class="fas fa-home me-2"></i> Dashboard</a>
        <a href="/details" class="<%= page === 'details' ? 'active' : '' %>"><i class="fas fa-list me-2"></i> Data
            Detail</a>
        <a href="/input-broadcast" class="<%= page === 'broadcast' ? 'active' : '' %>"><i
                class="fas fa-bullhorn me-2"></i> Broadcast WA</a>
    </div>

    <div class="content">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2>Dashboard</h2>
            <button id="refreshBtn" class="btn btn-primary"><i class="fas fa-sync-alt me-2"></i> Cek Absensi
                Sekarang</button>
        </div>

        <div class="row">
            <div class="col-md-6">
                <div class="card card-custom p-4 mb-4">
                    <h5>Status Terakhir</h5>
                    <% if (data && data.timestamp) { %>
                        <h3 class="text-success">OK</h3>
                        <p class="text-muted">Diperbarui: <%= data.timestamp %>
                        </p>
                        <% } else { %>
                            <h3 class="text-secondary">-</h3>
                            <p class="text-muted">Belum ada data.</p>
                            <% } %>
                </div>
            </div>
            <div class="col-md-6">
                <div class="card card-custom p-4 mb-4">
                    <h5>Ringkasan</h5>
                    <% if (data && data.results) { %>
                        <p>Total Data: <b>
                                <%= data.results.length %>
                            </b> Karyawan</p>
                        <% } else { %>
                            <p>Data tidak tersedia.</p>
                            <% } %>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        document.getElementById('refreshBtn').addEventListener('click', async () => {
            const btn = document.getElementById('refreshBtn');
            btn.disabled = true;
            btn.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i> Checking...';

            try {
                const res = await fetch('/api/run-check', { method: 'POST' });
                const result = await res.json();
                if (result.success) {
                    location.reload();
                } else {
                    alert('Error: ' + result.message);
                }
            } catch (e) {
                alert('Failed to connect to server');
            } finally {
                btn.disabled = false;
            }
        });
    </script>
</body>

</html>