<!DOCTYPE html>
<html lang="id">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Broadcast WA - Absensi Broadcast</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <style>
        body {
            background-color: #f8f9fa;
        }

        .sidebar {
            height: 100vh;
            position: fixed;
            top: 0;
            left: 0;
            width: 250px;
            background: #2c3e50;
            color: white;
            padding-top: 20px;
        }

        .sidebar a {
            color: #adb5bd;
            text-decoration: none;
            display: block;
            padding: 10px 20px;
        }

        .sidebar a:hover,
        .sidebar a.active {
            background: #34495e;
            color: white;
            border-left: 4px solid #3498db;
        }

        .content {
            margin-left: 250px;
            padding: 20px;
        }

        .card-custom {
            border: none;
            border-radius: 10px;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        }
    </style>
</head>

<body>

    <div class="sidebar">
        <h4 class="text-center mb-4">Absensi App</h4>
        <a href="/" class="<%= page === 'dashboard' ? 'active' : '' %>"><i class="fas fa-home me-2"></i> Dashboard</a>
        <a href="/karyawan" class="<%= page === 'karyawan' ? 'active' : '' %>"><i class="fas fa-users me-2"></i>
            Karyawan</a>
        <a href="/details" class="<%= page === 'details' ? 'active' : '' %>"><i class="fas fa-list me-2"></i> Data
            Detail</a>
        <a href="/input-broadcast" class="<%= page === 'broadcast' ? 'active' : '' %>"><i
                class="fas fa-bullhorn me-2"></i> Broadcast WA</a>
    </div>

    <div class="content">
        <h2 class="mb-4">Broadcast WhatsApp</h2>

        <div class="row">

            <!-- Manual Broadcast -->
            <div class="col-md-6">
                <div class="card card-custom p-4 mb-4">
                    <h5 class="mb-3">Manual Broadcast</h5>
                    <form id="broadcastForm">
                        <div class="mb-3">
                            <label class="form-label">WAHA API URL</label>
                            <input type="text" class="form-control" name="wahaUrl" value="<%= settings.wahaUrl %>"
                                required>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">API Key (Optional)</label>
                            <input type="text" class="form-control" name="apiKey" value="<%= settings.apiKey %>">
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Session ID</label>
                            <input type="text" class="form-control" name="sessionId" value="<%= settings.sessionId %>"
                                required>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Nomor Tujuan (Multi-Target Support)</label>
                            <textarea class="form-control" name="target" rows="3"
                                placeholder="Pisahkan dengan koma untuk multi-target"
                                required><%= settings.targetNumbers ? settings.targetNumbers.join(', ') : (settings.targetNumber || '') %></textarea>
                            <small class="text-muted">
                                Format: <code>6281xxx@c.us</code> (Personal) atau <code>120363xxx@g.us</code> (Grup)<br>
                                Contoh multi-target: <code>6281234567890@c.us, 120363423891026875@g.us</code>
                            </small>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Pesan</label>
                            <textarea class="form-control" name="message" rows="3" required>Test Broadcast</textarea>
                        </div>
                        <button type="submit" class="btn btn-success w-100" id="sendBtn"><i
                                class="fab fa-whatsapp me-2"></i> Kirim Pesan</button>
                    </form>
                </div>
            </div>

            <!-- Settings -->
            <div class="col-md-6">
                <div class="card card-custom p-4 mb-4">
                    <h5 class="mb-3">Pengaturan Otomatis</h5>
                    <form id="settingsForm">
                        <div class="form-check form-switch mb-3">
                            <input class="form-check-input" type="checkbox" id="autoBroadcast" name="autoBroadcast"
                                <%=settings.autoBroadcast ? 'checked' : '' %>>
                            <label class="form-check-label" for="autoBroadcast">Aktifkan Auto Broadcast</label>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Jadwal General (Semua) - HH:mm</label>
                            <input type="text" class="form-control" name="schedules"
                                value="<%= settings.schedules.join(', ') %>" placeholder="Ex: 08:00, 17:00">
                            <small class="text-muted">Pisahkan dengan koma</small>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Jadwal Khusus Izin/Cuti</label>
                            <input type="text" class="form-control" name="schedulesLeave"
                                value="<%= settings.schedulesLeave ? settings.schedulesLeave.join(', ') : '' %>"
                                placeholder="Ex: 09:00">
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Jadwal Khusus Terlambat/Alpha</label>
                            <input type="text" class="form-control" name="schedulesLate"
                                value="<%= settings.schedulesLate ? settings.schedulesLate.join(', ') : '' %>"
                                placeholder="Ex: 10:00">
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Jadwal Rekap Mingguan (Setiap Sabtu) - HH:mm</label>
                            <input type="text" class="form-control" name="schedulesWeeklyRecap"
                                value="<%= settings.schedulesWeeklyRecap ? settings.schedulesWeeklyRecap.join(', ') : '' %>"
                                placeholder="Ex: 12:00">
                            <small class="text-muted">Laporan rekap keterlambatan dan alpha bulanan</small>
                        </div>

                        <hr>
                        <h6 class="mb-3">Pengaturan Hari Libur (Tidak ada Broadcast)</h6>

                        <div class="mb-3">
                            <label class="form-label">Hari Libur Mingguan</label>
                            <div class="d-flex gap-3">
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" name="holidayDays" value="0"
                                        id="holidaySun" <%=settings.holidayDays && settings.holidayDays.includes('0')
                                        ? 'checked' : '' %>>
                                    <label class="form-check-label" for="holidaySun">Minggu</label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" name="holidayDays" value="6"
                                        id="holidaySat" <%=settings.holidayDays && settings.holidayDays.includes('6')
                                        ? 'checked' : '' %>>
                                    <label class="form-check-label" for="holidaySat">Sabtu</label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" name="holidayDays" value="5"
                                        id="holidayFri" <%=settings.holidayDays && settings.holidayDays.includes('5')
                                        ? 'checked' : '' %>>
                                    <label class="form-check-label" for="holidayFri">Jumat</label>
                                </div>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Tanggal Libur Spesifik (YYYY-MM-DD)</label>
                            <textarea class="form-control" name="holidays" rows="2"
                                placeholder="Contoh: 2024-01-01, 2024-08-17"><%= settings.holidays ? settings.holidays.join(', ') : '' %></textarea>
                            <small class="text-muted">Pisahkan dengan koma</small>
                        </div>
                        <hr>

                        <div class="mb-3">
                            <label class="form-label">Template Pesan</label>
                            <textarea class="form-control" name="messageTemplate"
                                rows="4"><%= settings.messageTemplate %></textarea>
                            <small class="text-muted">Variables: {{date}}, {{data}}</small>
                        </div>

                        <button type="submit" class="btn btn-primary w-100" id="saveBtn"><i
                                class="fas fa-save me-2"></i> Simpan Pengaturan</button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // Send Broadcast
        document.getElementById('broadcastForm').addEventListener('submit', async (e) => {
            e.preventDefault();
            const btn = document.getElementById('sendBtn');
            btn.disabled = true;
            btn.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i> Sending...';

            const formData = new FormData(e.target);
            const data = Object.fromEntries(formData.entries());

            try {
                const res = await fetch('/api/broadcast', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(data)
                });
                const result = await res.json();
                alert(result.message);
            } catch (err) {
                alert('Failed to send message');
            } finally {
                btn.disabled = false;
                btn.innerHTML = '<i class="fab fa-whatsapp me-2"></i> Kirim Pesan';
            }
        });

        // Save Settings
        document.getElementById('settingsForm').addEventListener('submit', async (e) => {
            e.preventDefault();
            const btn = document.getElementById('saveBtn');
            btn.disabled = true;
            btn.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i> Saving...';

            const formData = new FormData(e.target);
            const data = Object.fromEntries(formData.entries());

            // Fix: Checkboxes with same name need manual collection
            const holidayDays = [];
            document.querySelectorAll('input[name="holidayDays"]:checked').forEach(cb => {
                holidayDays.push(cb.value);
            });
            data.holidayDays = holidayDays;

            // Include Connection Settings from the Manual Form
            // ensure we grab the values properly
            const manualForm = document.getElementById('broadcastForm');
            if (manualForm) {
                data.wahaUrl = manualForm.querySelector('[name="wahaUrl"]').value;
                data.sessionId = manualForm.querySelector('[name="sessionId"]').value;
                data.apiKey = manualForm.querySelector('[name="apiKey"]').value;
                data.targetNumbers = manualForm.querySelector('[name="target"]').value;
            }

            // Checkbox handling for boolean
            if (!data.autoBroadcast) data.autoBroadcast = 'off';

            try {
                const res = await fetch('/api/settings', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(data)
                });
                const result = await res.json();
                alert(result.message);
                location.reload();
            } catch (err) {
                alert('Failed to save settings');
            } finally {
                btn.disabled = false;
                btn.innerHTML = '<i class="fas fa-save me-2"></i> Simpan Pengaturan';
            }
        });
    </script>
</body>

</html>