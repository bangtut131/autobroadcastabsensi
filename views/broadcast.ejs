<!DOCTYPE html>
<html lang="id">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Broadcast - Absensi Broadcast</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <style>
        body {
            background-color: #f8f9fa;
        }

        .sidebar {
            height: 100vh;
            position: fixed;
            top: 0;
            left: 0;
            width: 250px;
            background: #2c3e50;
            color: white;
            padding-top: 20px;
        }

        .sidebar a {
            color: #adb5bd;
            text-decoration: none;
            display: block;
            padding: 10px 20px;
        }

        .sidebar a:hover,
        .sidebar a.active {
            background: #34495e;
            color: white;
            border-left: 4px solid #3498db;
        }

        .content {
            margin-left: 250px;
            padding: 20px;
        }

        .card-custom {
            border: none;
            border-radius: 10px;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        }
    </style>
</head>

<body>

    <div class="sidebar">
        <h4 class="text-center mb-4">Absensi App</h4>
        <a href="/" class="<%= page === 'dashboard' ? 'active' : '' %>"><i class="fas fa-home me-2"></i> Dashboard</a>
        <a href="/details" class="<%= page === 'details' ? 'active' : '' %>"><i class="fas fa-list me-2"></i> Data
            Detail</a>
        <a href="/input-broadcast" class="<%= page === 'broadcast' ? 'active' : '' %>"><i
                class="fas fa-bullhorn me-2"></i> Broadcast WA</a>
    </div>

    <div class="content">
        <h2 class="mb-4">Pengaturan Broadcast</h2>

        <div class="row">
            <!-- Settings Form -->
            <div class="col-md-7">
                <div class="card card-custom p-4 mb-4">
                    <h5 class="mb-3">Konfigurasi</h5>
                    <form id="settingsForm">
                        <div class="mb-3">
                            <label class="form-label">WAHA API URL</label>
                            <input type="text" class="form-control" name="wahaUrl" value="<%= settings.wahaUrl %>"
                                placeholder="http://localhost:3000">
                        </div>
                        <div class="mb-3">
                            <label class="form-label">WAHA Session ID</label>
                            <input type="text" class="form-control" name="sessionId"
                                value="<%= settings.sessionId || 'default' %>" placeholder="default">
                            <div class="form-text">Nama sesi yang digunakan di WAHA (default: 'default').</div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">API Key (Optional)</label>
                            <input type="password" class="form-control" name="apiKey"
                                value="<%= settings.apiKey || '' %>" placeholder="Isi jika WAHA diproteksi password">
                            <div class="form-text">Biarkan kosong jika tidak menggunakan keamanan API Key.</div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Target Nomor WA / Group ID</label>
                            <input type="text" class="form-control" name="targetNumber"
                                value="<%= settings.targetNumber %>" placeholder="628123456789 atau 12036...g.us">
                            <div class="form-text">Gunakan ID Group jika ingin mengirim ke grup.</div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Template Pesan</label>
                            <textarea class="form-control" name="messageTemplate" rows="4"
                                placeholder="Gunakan {{date}} untuk tanggal dan {{data}} untuk list absensi"><%= settings.messageTemplate %></textarea>
                            <div class="form-text"><strong>Shortcodes:</strong> <code>{{date}}</code> = Tanggal hari
                                ini, <code>{{data}}</code> = List data karyawan.</div>
                        </div>
                        <div class="mb-3 form-check form-switch">
                            <input class="form-check-input" type="checkbox" name="autoBroadcast" id="autoBroadcast"
                                <%=settings.autoBroadcast ? 'checked' : '' %>>
                            <label class="form-check-label" for="autoBroadcast">Aktifkan Auto Broadcast</label>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Jadwal Laporan Umum (Semua Data)</label>
                            <input type="text" class="form-control" name="schedules"
                                value="<%= (settings.schedules || []).join(', ') %>" placeholder="08:00, 17:00">
                            <div class="form-text">Laporan lengkap kehadiran karyawan.</div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Jadwal Laporan Cuti/Izin</label>
                            <input type="text" class="form-control" name="schedulesLeave"
                                value="<%= (settings.schedulesLeave || []).join(', ') %>" placeholder="08:30">
                            <div class="form-text">Hanya menampilkan karyawan yang Cuti atau Izin.</div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Jadwal Laporan Terlambat/Alpha</label>
                            <input type="text" class="form-control" name="schedulesLate"
                                value="<%= (settings.schedulesLate || []).join(', ') %>" placeholder="10:00">
                            <div class="form-text">Hanya menampilkan karyawan yang Terlambat atau Alpha/Bolos.</div>
                        </div>
                        <button type="submit" class="btn btn-primary"><i class="fas fa-save me-2"></i> Simpan
                            Pengaturan</button>
                    </form>
                </div>
            </div>

            <!-- Manual Broadcast -->
            <div class="col-md-5">
                <div class="card card-custom p-4 bg-white">
                    <h5 class="mb-3">Test Manual</h5>
                    <p>Kirim pesan test ke target di atas.</p>
                    <div class="mb-3">
                        <textarea class="form-control" id="manualMessage" rows="3"
                            placeholder="Isi pesan manual (opsional)..."></textarea>
                    </div>
                    <button id="broadcastBtn" class="btn btn-success w-100"><i class="fas fa-paper-plane me-2"></i>
                        Kirim Broadcast Sekarang</button>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        document.getElementById('settingsForm').addEventListener('submit', async (e) => {
            e.preventDefault();
            const formData = new FormData(e.target);
            const data = Object.fromEntries(formData.entries());
            data.autoBroadcast = document.getElementById('autoBroadcast').checked;

            try {
                const res = await fetch('/api/settings', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(data)
                });
                const result = await res.json();
                alert(result.message);
            } catch (err) {
                alert('Gagal menyimpan settings');
            }
        });

        document.getElementById('broadcastBtn').addEventListener('click', async () => {
            const message = document.getElementById('manualMessage').value || "Test Broadcast Manual";

            // Get values directly from inputs to allow testing without saving
            const target = document.querySelector('input[name="targetNumber"]').value;
            const wahaUrl = document.querySelector('input[name="wahaUrl"]').value;
            const sessionId = document.querySelector('input[name="sessionId"]').value;
            const apiKey = document.querySelector('input[name="apiKey"]').value;

            if (!target) {
                alert('Target Number harus diisi!');
                return;
            }

            if (!confirm(`Kirim pesan ini ke ${target}?`)) return;

            try {
                const res = await fetch('/api/broadcast', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        message,
                        target,
                        wahaUrl, // Optional: backend needs to support overriding these if passed
                        sessionId,
                        apiKey
                    })
                });
                const result = await res.json();
                if (result.success) {
                    alert(result.message);
                } else {
                    alert('Error: ' + result.message);
                }
            } catch (err) {
                console.error(err);
                alert('Gagal mengirim broadcast (Network Error)');
            }
        });
    </script>
</body>

</html>