<!DOCTYPE html>
<html lang="id">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Data Karyawan - Absensi Broadcast</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <style>
        body {
            background-color: #f8f9fa;
        }

        .sidebar {
            height: 100vh;
            position: fixed;
            top: 0;
            left: 0;
            width: 250px;
            background: #2c3e50;
            color: white;
            padding-top: 20px;
        }

        .sidebar a {
            color: #adb5bd;
            text-decoration: none;
            display: block;
            padding: 10px 20px;
        }

        .sidebar a:hover,
        .sidebar a.active {
            background: #34495e;
            color: white;
            border-left: 4px solid #3498db;
        }

        .content {
            margin-left: 250px;
            padding: 20px;
        }

        .card-custom {
            border: none;
            border-radius: 10px;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        }

        .table-custom th {
            background: #ecf0f1;
            border-top: none;
        }
    </style>
</head>

<body>

    <div class="sidebar">
        <h4 class="text-center mb-4">Absensi App</h4>
        <a href="/" class="<%= page === 'dashboard' ? 'active' : '' %>"><i class="fas fa-home me-2"></i> Dashboard</a>
        <a href="/karyawan" class="<%= page === 'karyawan' ? 'active' : '' %>"><i class="fas fa-users me-2"></i>
            Karyawan</a>
        <a href="/details" class="<%= page === 'details' ? 'active' : '' %>"><i class="fas fa-list me-2"></i> Data
            Detail</a>
        <a href="/input-broadcast" class="<%= page === 'broadcast' ? 'active' : '' %>"><i
                class="fas fa-bullhorn me-2"></i> Broadcast WA</a>
    </div>

    <div class="content">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2>Data Karyawan</h2>
            <button id="refreshBtn" class="btn btn-primary"><i class="fas fa-sync-alt me-2"></i> Tarik Data
                (Gaji.ID)</button>
        </div>

        <div class="card card-custom p-4">
            <% if (data && data.timestamp) { %>
                <p class="text-muted"><i class="fas fa-clock me-2"></i> Update Terakhir: <%= data.timestamp %>
                </p>

                <div class="table-responsive">
                    <table class="table table-hover table-custom">
                        <thead>
                            <tr>
                                <th>No</th>
                                <th>ID</th>
                                <th>Nama Karyawan</th>
                                <th>Posisi</th>
                                <th>Departemen/Divisi</th>
                                <th>Status</th>
                                <th>Mulai Join</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (data.results && data.results.length> 0) { %>
                                <% data.results.forEach((item, index)=> { %>
                                    <tr>
                                        <td>
                                            <%= index + 1 %>
                                        </td>
                                        <td><span class="badge bg-secondary">
                                                <%= item.nik %>
                                            </span></td>
                                        <td>
                                            <%= item.nama %>
                                        </td>
                                        <td>
                                            <%= item.posisi || '-' %>
                                        </td>
                                        <td>
                                            <%= item.departemen || '-' %>
                                        </td>
                                        <td>
                                            <% if (item.status==='Hadir' ) { %>
                                                <span class="badge bg-success">Hadir</span>
                                                <% } else { %>
                                                    <span class="badge bg-warning text-dark">
                                                        <%= item.status %>
                                                    </span>
                                                    <% } %>
                                        </td>
                                        <td>
                                            <%= item.joinDate || '-' %>
                                        </td>
                                    </tr>
                                    <% }); %>
                                        <% } else { %>
                                            <tr>
                                                <td colspan="7" class="text-center text-muted py-4">Tidak ada data
                                                    karyawan. Silakan tarik data.</td>
                                            </tr>
                                            <% } %>
                        </tbody>
                    </table>
                </div>
                <% } else { %>
                    <div class="text-center py-5">
                        <p class="text-muted">Data belum tersedia.</p>
                        <button onclick="document.getElementById('refreshBtn').click()" class="btn btn-primary">Tarik
                            Data Sekarang</button>
                    </div>
                    <% } %>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        document.getElementById('refreshBtn').addEventListener('click', async () => {
            const btn = document.getElementById('refreshBtn');
            btn.disabled = true;
            btn.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i> Mengambil Data...';

            try {
                // Fetch from the new employee sync endpoint
                const res = await fetch('/api/karyawan/sync', { method: 'POST' });
                const result = await res.json();

                if (result.success) {
                    location.reload();
                } else {
                    // Show error in table instead of annoying alert
                    const tbody = document.querySelector('tbody');
                    tbody.innerHTML = `
                        <tr>
                            <td colspan="7" class="text-center text-danger py-4">
                                <i class="fas fa-exclamation-triangle me-2"></i> ${result.message}<br>
                                <small class="text-muted">Pastikan konfigurasi API sudah benar.</small>
                            </td>
                        </tr>
                    `;
                }
            } catch (e) {
                alert('Failed to connect to server: ' + e.message);
            } finally {
                btn.disabled = false;
                btn.innerHTML = '<i class="fas fa-sync-alt me-2"></i> Tarik Data (Gaji.ID)';
            }
        });
    </script>
</body>

</html>