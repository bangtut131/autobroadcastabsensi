<!DOCTYPE html>
<html lang="id">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Detail - Absensi Broadcast</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <style>
        body {
            background-color: #f8f9fa;
        }

        .sidebar {
            height: 100vh;
            position: fixed;
            top: 0;
            left: 0;
            width: 250px;
            background: #2c3e50;
            color: white;
            padding-top: 20px;
        }

        .sidebar a {
            color: #adb5bd;
            text-decoration: none;
            display: block;
            padding: 10px 20px;
        }

        .sidebar a:hover,
        .sidebar a.active {
            background: #34495e;
            color: white;
            border-left: 4px solid #3498db;
        }

        .content {
            margin-left: 250px;
            padding: 20px;
        }

        .card-custom {
            border: none;
            border-radius: 10px;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        }

        .table-custom th {
            background: #ecf0f1;
            border-top: none;
        }
    </style>
</head>

<body>

    <div class="sidebar">
        <h4 class="text-center mb-4">Absensi App</h4>
        <a href="/" class="<%= page === 'dashboard' ? 'active' : '' %>"><i class="fas fa-home me-2"></i> Dashboard</a>
        <a href="/details" class="<%= page === 'details' ? 'active' : '' %>"><i class="fas fa-list me-2"></i> Data
            Detail</a>
        <a href="/input-broadcast" class="<%= page === 'broadcast' ? 'active' : '' %>"><i
                class="fas fa-bullhorn me-2"></i> Broadcast WA</a>
    </div>

    <div class="content">
        <h2 class="mb-4">Data Absensi Detail</h2>

        <div class="card card-custom p-4">
            <% if (data && data.timestamp) { %>
                <p class="text-muted"><i class="fas fa-clock me-2"></i> Update Terakhir: <%= data.timestamp %>
                </p>

                <div class="table-responsive">
                    <table class="table table-hover table-custom">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Nama Karyawan</th>
                                <th>NIK</th>
                                <th>Masuk</th>
                                <th>Keluar</th>
                                <th>Terlambat (Min)</th>
                                <th>Status</th>
                                <th>Keterangan</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (data.results && data.results.length> 0) { %>
                                <% data.results.forEach((item, index)=> { %>
                                    <tr>
                                        <td>
                                            <%= index + 1 %>
                                        </td>
                                        <td>
                                            <%= item.nama %>
                                        </td>
                                        <td>
                                            <%= item.nik %>
                                        </td>
                                        <td><span class="badge bg-success">
                                                <%= item.jamMasuk %>
                                            </span></td>
                                        <td><span class="badge bg-secondary">
                                                <%= item.jamKeluar %>
                                            </span></td>
                                        <td>
                                            <% if (item.menitTerlambat> 0) { %>
                                                <span class="text-danger fw-bold">
                                                    <%= item.menitTerlambat %>
                                                </span>
                                                <% } else { %>
                                                    <span class="text-muted">0</span>
                                                    <% } %>
                                        </td>
                                        <td>
                                            <%= item.status %>
                                        </td>
                                        <td>
                                            <% if (item.keterangan && item.keterangan !=='-' ) { %>
                                                <span class="text-info">
                                                    <%= item.keterangan %>
                                                </span>
                                                <% } else { %>
                                                    -
                                                    <% } %>
                                        </td>
                                    </tr>
                                    <% }); %>
                                        <% } else { %>
                                            <tr>
                                                <td colspan="8" class="text-center text-muted py-4">Tidak ada data
                                                    karyawan.</td>
                                            </tr>
                                            <% } %>
                        </tbody>
                    </table>
                </div>
                <% } else { %>
                    <div class="text-center py-5">
                        <p class="text-muted">Data belum tersedia.</p>
                        <a href="/" class="btn btn-primary">Kembali ke Dashboard untuk Cek Data</a>
                    </div>
                    <% } %>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>

</html>